---
import { site } from '../config';
import '../styles/styles.css';
---
<!doctype html>
<html lang={site.lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{site.title}</title>
  <meta name="description" content={site.description}>
  <meta name="theme-color" content="#140c0e">
  <meta name="generator" content={Astro.generator}>
  <meta property="og:title" content={site.title}>
  <meta property="og:description" content={site.description}>
  <meta property="og:image" content={site.ogImage}>
  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}favicon.svg`}>

  <!-- Apply the saved theme before first paint, so the page never flashes the wrong theme -->
  <script is:inline>
    (function () {
      var t = 'dark';
      try { t = localStorage.getItem('solenne-theme') || 'dark'; } catch (e) {}
      document.documentElement.setAttribute('data-theme', t);
      document.documentElement.classList.add('js');
    })();
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://images.unsplash.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500&family=Inter:wght@400;500;600&display=swap">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/regular/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/bold/style.css">
</head>
<body data-tz={site.timeZone} data-locale={site.locale} data-lat={site.latitude} data-lon={site.longitude}>
<slot />
<script>
  import '../scripts/main.js';
</script>
</body>
</html>
