---
import { site } from '../config';
---
    <section id="top" class="hero-wrap">
      <div class="hero force-dark">
        <picture class="hero__img">
          <img src="https://images.unsplash.com/photo-1784007686796-bcaaf1044000?auto=format&amp;fit=crop&amp;w=1600&amp;h=1068&amp;q=75" srcset="https://images.unsplash.com/photo-1784007686796-bcaaf1044000?auto=format&amp;fit=crop&amp;w=800&amp;h=534&amp;q=75 800w, https://images.unsplash.com/photo-1784007686796-bcaaf1044000?auto=format&amp;fit=crop&amp;w=1200&amp;h=801&amp;q=75 1200w, https://images.unsplash.com/photo-1784007686796-bcaaf1044000?auto=format&amp;fit=crop&amp;w=1600&amp;h=1068&amp;q=75 1600w, https://images.unsplash.com/photo-1784007686796-bcaaf1044000?auto=format&amp;fit=crop&amp;w=2400&amp;h=1602&amp;q=75 2400w" sizes="100vw" alt="A light-filled townhouse facade framed by bougainvillea" width="1600" height="1068" fetchpriority="high">
        </picture>
        <div class="hero__shade"></div>
        <div class="hero__content">
          <div class="kicker">Boutique hotel · {site.city}</div>
          <h1>Comfortable stays, with a <span class="grad-text">personal touch.</span></h1>
          <p class="hero__sub">A family-run townhouse in {site.place} — five minutes from the Metro, with easy links to the old town and the airport.</p>
          <div class="hero__ctas">
            <a href="#book" class="btn btn--primary">Book your stay <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
            <a href="#rooms" class="btn btn--glass">Explore rooms</a>
          </div>
        </div>
      </div>

      <!-- ============ Booking bar ============ -->
      <form id="book" class="booking" autocomplete="off" aria-label="Check availability">
        <div class="booking__backdrop" id="bookingBackdrop" hidden></div>
        <div class="booking__bar">
          <button type="button" class="cell" data-open="in" aria-haspopup="dialog" aria-expanded="false" aria-controls="calPop">
            <span class="label">Check-in</span>
            <span class="cell__value"><i class="ph ph-calendar-blank" aria-hidden="true"></i><span id="inLabel">Add date</span></span>
          </button>
          <button type="button" class="cell" data-open="out" aria-haspopup="dialog" aria-expanded="false" aria-controls="calPop">
            <span class="label">Check-out</span>
            <span class="cell__value"><i class="ph ph-calendar-blank" aria-hidden="true"></i><span id="outLabel">Add date</span></span>
          </button>
          <button type="button" class="cell" data-open="guests" aria-haspopup="dialog" aria-expanded="false" aria-controls="guestPop">
            <span class="label">Guests</span>
            <span class="cell__value">
              <i class="ph ph-users" aria-hidden="true"></i>
              <span class="truncate" id="guestLabel">2 adults</span>
              <i class="ph ph-paw-print" id="petIcon" title="Travelling with pets" hidden></i>
              <i class="ph ph-caret-down caret" aria-hidden="true"></i>
            </span>
          </button>
          <button type="submit" class="cell--go">Check availability <i class="ph ph-magnifying-glass" aria-hidden="true"></i></button>
        </div>

        <!-- Calendar popover -->
        <div class="popover" id="calPop" role="dialog" aria-label="Choose dates" hidden>
          <div class="cal__head">
            <button type="button" class="round-btn" id="prevMonth" aria-label="Previous month"><i class="ph ph-caret-left" aria-hidden="true"></i></button>
            <span class="cal__month" id="monthLabel" aria-live="polite"></span>
            <button type="button" class="round-btn" id="nextMonth" aria-label="Next month"><i class="ph ph-caret-right" aria-hidden="true"></i></button>
          </div>
          <div class="cal__week" aria-hidden="true"><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span><span>Su</span></div>
          <div class="cal__grid" id="calGrid"></div>
          <div class="cal__foot">
            <span class="cal__hint" id="calHint">Select check-in</span>
            <button type="button" class="link-btn" id="clearDates">Clear</button>
          </div>
        </div>

        <!-- Guests popover -->
        <div class="popover" id="guestPop" role="dialog" aria-label="Choose guests" hidden>
          <div class="g-row">
            <div class="g-row__text"><span class="g-row__label">Adults</span><span class="g-row__sub">Ages 13+</span></div>
            <div class="stepper">
              <button type="button" class="round-btn round-btn--accent" data-step="adults" data-by="-1" aria-label="Fewer adults"><i class="ph ph-minus" aria-hidden="true"></i></button>
              <output id="adultsOut" aria-live="polite">2</output>
              <button type="button" class="round-btn round-btn--accent" data-step="adults" data-by="1" aria-label="More adults"><i class="ph ph-plus" aria-hidden="true"></i></button>
            </div>
          </div>
          <div class="g-row">
            <div class="g-row__text"><span class="g-row__label">Children</span><span class="g-row__sub">Ages 0–12</span></div>
            <div class="stepper">
              <button type="button" class="round-btn round-btn--accent" data-step="children" data-by="-1" aria-label="Fewer children"><i class="ph ph-minus" aria-hidden="true"></i></button>
              <output id="childrenOut" aria-live="polite">0</output>
              <button type="button" class="round-btn round-btn--accent" data-step="children" data-by="1" aria-label="More children"><i class="ph ph-plus" aria-hidden="true"></i></button>
            </div>
          </div>
          <button type="button" class="g-row g-row--check" id="petsToggle" role="checkbox" aria-checked="false">
            <span class="g-row__text"><span class="g-row__label">Travelling with pets</span><span class="g-row__sub">Let us know in advance</span></span>
            <span class="checkbox"><i class="ph-bold ph-check" aria-hidden="true"></i></span>
          </button>
          <button type="button" class="done-btn" id="guestsDone">Done</button>
        </div>
      </form>
    </section>
