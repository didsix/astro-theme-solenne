---
import { site } from '../config';
import Emblem from './Emblem.astro';
---
  <header class="site-header">
    <nav class="nav" aria-label="Main">
      <a href="#top" class="brand" aria-label={`${site.name}, back to top`}>
        <Emblem />
        <span class="brand__name">{site.name.toUpperCase()}</span>
        <span class="brand__place">{site.place.toUpperCase()}</span>
      </a>
      <div class="nav__links">
        <a href="#rooms">Rooms</a>
        <a href="#location">Location</a>
        <a href="#direct">Book direct</a>
        <a href="#stories">Guests</a>
      </div>
      <button class="theme-toggle" type="button" id="themeToggle" aria-label="Toggle light and dark mode">
        <i class="ph ph-sun" aria-hidden="true"></i><i class="ph ph-moon" aria-hidden="true"></i>
      </button>
      <a href="#book" class="nav__cta" aria-label="Book your stay"><span class="nav__cta-text">Book your stay</span> <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
    </nav>
  </header>
