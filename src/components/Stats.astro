---
import { site } from '../config';
---
    <section class="stats" aria-label={`${site.name} in numbers`}>
      <div class="stat reveal"><div class="stat__value">30+</div><div class="stat__label">Years of hospitality</div><div class="stat__body">Decades helping guests feel at home in {site.city}.</div></div>
      <div class="stat reveal"><div class="stat__value">5</div><div class="stat__label">Minutes to the station</div><div class="stat__body">An easy walk to the Metro.</div></div>
      <div class="stat reveal"><div class="stat__value">4</div><div class="stat__label">Room types</div><div class="stat__body">Solo stays, couples, friends and families.</div></div>
      <div class="stat reveal"><div class="stat__value">100%</div><div class="stat__label">Direct booking focus</div><div class="stat__body">Personal availability, support and value.</div></div>
    </section>
