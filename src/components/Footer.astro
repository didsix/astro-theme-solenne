---
import { site } from '../config';
import Emblem from './Emblem.astro';
---
  <footer class="footer">
    <div class="footer__cols">
      <div class="footer__col">
        <Emblem size="footer" />
        <p>A family-run hotel in a townhouse, {site.place}, {site.city}.</p>
      </div>
      <div class="footer__col">
        <span class="label">Explore</span>
        <a href="#rooms">Rooms</a><a href="#location">Location</a><a href="#direct">Book direct</a>
      </div>
      <div class="footer__col">
        <span class="label">Stay</span>
        <span>Check-in from 2:00 PM</span><span>Check-out until 11:00 AM</span>
      </div>
      <div class="footer__col">
        <span class="label">Questions?</span>
        <a href="#book" class="btn btn--outline">Ask about your stay <i class="ph ph-chat-circle" aria-hidden="true"></i></a>
      </div>
    </div>
    <div class="footer__copy">© <span id="year">{new Date().getFullYear()}</span> {site.name} · {site.city} · Theme by <a href="https://sv3n.dev?utm_source=astro-theme&amp;utm_medium=referral&amp;utm_campaign=solenne">Sv3n</a></div>
  </footer>
