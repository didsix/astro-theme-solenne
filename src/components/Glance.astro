---
import { site } from '../config';
---
    <section class="glance" aria-label="At a glance">
      <div class="glance__pair">
        <div class="card reveal">
          <div class="card__head label"><span>{site.city} now</span><i class="ph ph-clock" aria-hidden="true"></i></div>
          <div class="card__big" id="clockTime">--:--</div>
          <div class="card__sub" id="clockDate">&nbsp;</div>
        </div>
        <div class="card reveal">
          <div class="card__head label"><span>Weather · {site.city}</span><i class="ph ph-cloud-sun" aria-hidden="true"></i></div>
          <div class="card__big" id="temp">--°</div>
          <div class="card__sub" id="weatherLine">Loading {site.city} weather…</div>
        </div>
      </div>
      <div class="glance__pair">
        <div class="card reveal">
          <div class="card__head label"><span>Stay times</span><i class="ph ph-key" aria-hidden="true"></i></div>
          <dl class="rows" style="margin:0">
            <div><dt>Check-in</dt><dd>From 2:00 PM</dd></div>
            <div><dt>Check-out</dt><dd>Until 11:00 AM</dd></div>
          </dl>
        </div>
        <div class="card reveal">
          <div class="card__head label"><span>Getting around</span><i class="ph ph-train-simple" aria-hidden="true"></i></div>
          <dl class="rows" style="margin:0">
            <div><dt>Metro station</dt><dd>5 min walk</dd></div>
            <div><dt>Old town</dt><dd>~15 min</dd></div>
            <div><dt>Airport</dt><dd>~25 min</dd></div>
          </dl>
        </div>
      </div>
    </section>
