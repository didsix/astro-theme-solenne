---
/**
 * The hotel crest: an arched doorway with the brand initial. Pure SVG, so it
 * follows the light/dark theme through currentColor. Replace with your own
 * logo (an <img> works too — header height is 40px, footer width 64px).
 */
import { site } from '../config';
interface Props { size?: 'header' | 'footer' }
const { size = 'header' } = Astro.props;
const initial = site.name.charAt(0).toUpperCase();
---
<svg
  class:list={['emblem', `emblem--${size}`]}
  viewBox="0 0 90 120"
  width={size === 'footer' ? 64 : 30}
  height={size === 'footer' ? 85 : 40}
  role={size === 'footer' ? 'img' : undefined}
  aria-label={size === 'footer' ? site.name : undefined}
  aria-hidden={size === 'footer' ? undefined : 'true'}
>
  <path d="M8 116V46a37 37 0 0 1 74 0v70" fill="none" stroke="currentColor" stroke-width="3" />
  <path d="M17 116V48a28 28 0 0 1 56 0v68" fill="none" stroke="currentColor" stroke-width="1.2" opacity=".55" />
  <line x1="2" y1="116" x2="88" y2="116" stroke="currentColor" stroke-width="3" />
  <text x="45" y="84" text-anchor="middle" font-family="Cormorant Garamond, Georgia, serif" font-size="46" font-weight="500" fill="currentColor">{initial}</text>
</svg>
<style>
  .emblem { display: block; color: var(--kicker, currentColor); }
  .emblem--header { height: 40px; width: auto; }
  .emblem--footer { width: 64px; height: auto; }
  @media (max-width: 760px) { .emblem--header { height: 34px; } }
</style>
