---
import { site } from '../config';
---
    <section id="location" class="section">
      <div class="section-head reveal">
        <div class="kicker">Why {site.place}</div>
        <h2 class="h2">A practical base for city plans.</h2>
      </div>
      <div class="reasons">
        <a href="#book" class="reason reveal">
          <div class="reason__top"><i class="ph ph-microphone-stage" aria-hidden="true"></i><span class="label">Events &amp; shows</span></div>
          <h3>Close to the concert halls.</h3>
          <p>A well-connected base near the city’s main venues and transport for concerts and theatre nights.</p>
          <div class="reason__cta">Explore the location <i class="ph ph-arrow-right" aria-hidden="true"></i></div>
        </a>
        <a href="#rooms" class="reason reveal">
          <div class="reason__top"><i class="ph ph-shopping-bag" aria-hidden="true"></i><span class="label">City breaks</span></div>
          <h3>A quieter option near the shops.</h3>
          <p>Quick access to the city’s hotspots, with a relaxed place to return to at the end of the day.</p>
          <div class="reason__cta">See room options <i class="ph ph-arrow-right" aria-hidden="true"></i></div>
        </a>
        <a href="#book" class="reason reveal">
          <div class="reason__top"><i class="ph ph-airplane-tilt" aria-hidden="true"></i><span class="label">Airport-friendly</span></div>
          <h3>Simple airport access.</h3>
          <p>Arriving late or leaving early, the Metro makes airport-connected stays easy.</p>
          <div class="reason__cta">Ask about your dates <i class="ph ph-arrow-right" aria-hidden="true"></i></div>
        </a>
      </div>
    </section>
