---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Glance from '../components/Glance.astro';
import Rooms from '../components/Rooms.astro';
import Direct from '../components/Direct.astro';
import Stats from '../components/Stats.astro';
import Location from '../components/Location.astro';
import Stories from '../components/Stories.astro';
import Footer from '../components/Footer.astro';
---
<Base>
<div class="page">
  <Header />
  <main>
    <Hero />
    <Glance />
    <Rooms />
    <Direct />
    <Stats />
    <Location />
    <Stories />
  </main>
  <Footer />
</div>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
<!-- Placeholder photography: Unsplash (Jamie Trinh, Antonio Araujo, Neon Wang, Dave Weatherall, Rod Long). -->
</Base>
